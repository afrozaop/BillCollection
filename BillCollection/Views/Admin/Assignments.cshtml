@using BillCollection.Models

@{
    ViewData["Title"] = "Manage Assignments";

    var users = ViewBag.Users as List<AppUser>;
    var providers = ViewBag.Providers as List<BillProvider>;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Manage Bill Provider Assignments</h2>

            <p class="text-muted">
                Assign one or more bill providers to a branch user.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            ← Dashboard
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm border-0">

        <div class="card-header">
            <h5 class="mb-0">
                User → Bill Provider Assignment
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="Assignments"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- User -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Select Branch User
                    </label>

                    <select name="appUserId"
                            id="appUserId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select User --
                        </option>

                        @foreach (var user in users)
                        {
                            <option value="@user.Id">
                                @user.Username -
                                @user.DisplayName
                                -
                                @(user.Branch?.Name ?? "No Branch")
                            </option>
                        }

                    </select>

                </div>


                <!-- Providers -->

                <label class="form-label fw-bold">
                    Select Bill Providers
                </label>

                <div class="row">

                    @foreach (var provider in providers)
                    {
                        <div class="col-md-4 col-lg-3 mb-3">

                            <div class="form-check border rounded p-3">

                                <input class="form-check-input provider-checkbox"
                                       type="checkbox"
                                       name="providerIds"
                                       value="@provider.Id"
                                       id="provider_@provider.Id">

                                <label class="form-check-label fw-semibold"
                                       for="provider_@provider.Id">

                                    @provider.ProviderName

                                    <small class="text-muted d-block">
                                        @provider.ProviderCode
                                    </small>

                                </label>

                            </div>

                        </div>
                    }

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        Save Assignment

                    </button>

                    <button type="reset"
                            class="btn btn-secondary ms-2">

                        Clear

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>