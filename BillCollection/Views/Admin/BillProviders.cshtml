@model List<BillCollection.Models.BillProvider>

@{
    ViewData["Title"] = "Bill Providers";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">Bill Providers</h3>
            <p class="text-muted mb-0">
                Manage bill providers and branch provider access.
            </p>
        </div>

        <!-- Branch Provider Access Button -->
        <a asp-controller="Admin"
           asp-action="BranchProviderAccess"
           class="btn btn-primary">
            <i class="bi bi-diagram-3 me-1"></i>
            Branch Provider Access
        </a>
        <a asp-controller="Admin"
           asp-action="CreateBillProvider"
           class="btn btn-primary">
            + Add Bill Provider
        </a>
    </div>


    <!-- Bill Provider List -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">Bill Provider List</h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                       
                                <th style="width:80px;">ID</th>
                                <th>Provider Code</th>
                                <th>Provider Name</th>
                                <th style="width:120px;">Status</th>
                                <th style="width:180px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var provider in Model.OrderBy(p => p.Id))
                            {
                                <tr>

                                    <td>
                                        @provider.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @provider.ProviderCode
                                        </strong>
                                    </td>

                                    <td>
                                        @provider.ProviderName
                                    </td>

                                    <td>
                                        @if (provider.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                       @*  <a asp-controller="Admin"
                                           asp-action="EditBillProvider"
                                           asp-route-id="@provider.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a> *@
                                        @if (provider.IsActive)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="DeactivateBillProvider"
                                                  asp-route-id="@provider.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Deactivate this provider?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle"></i>
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ActivateBillProvider"
                                                  asp-route-id="@provider.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Activate this provider?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-check-circle"></i>
                                                    Activate
                                                </button>
                                            </form>
                                        }
                                    </td>
                                   
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-database fs-2"></i>
                    <p class="mt-2 mb-0">
                        No bill providers found.
                    </p>
                </div>
            }

        </div>

    </div>
 

</div>
