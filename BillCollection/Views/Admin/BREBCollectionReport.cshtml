@model BillCollection.ViewModels.BREB.BREBAdminCollectionReportViewModel

@{
    ViewData["Title"] = "BREB Collection Report";
}

<div class="container-fluid mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt"></i>
                BREB Collection Report
            </h2>
            <p class="text-muted mb-0">
                View BREB collection transactions by date and branch.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>
    </div>

    <!-- REPORT CARD -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-search me-1"></i>
                Search Collection
            </h5>
        </div>

        <div class="card-body">

            <!-- SEARCH FILTER -->
            <form asp-controller="Admin"
                  asp-action="BREBCollectionReport"
                  method="get"
                  class="row g-3 mb-4">

                <!-- COLLECTION DATE -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Collection Date
                    </label>

                    <input type="date"
                           name="collectionDate"
                           value="@Model.CollectionDate.ToString("yyyy-MM-dd")"
                           class="form-control"
                           required />
                </div>

                <!-- BRANCH CODE -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Branch Code
                    </label>

                    <input type="text"
                           name="branchCode"
                           value="@Model.BranchCode"
                           class="form-control"
                           placeholder="Enter Branch Code (e.g. 0201)" />
                </div>

                <!-- BUTTONS -->
                <div class="col-md-4 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <a asp-controller="Admin"
                       asp-action="BREBCollectionReport"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>

                </div>

            </form>

            <hr />

            <!-- SUMMARY -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body">
                            <div class="text-muted">
                                Total Transactions
                            </div>
                            <h3 class="fw-bold mb-0">
                                @Model.TotalTransactions.ToString("N0")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body">
                            <div class="text-muted">
                                Total Collection Amount
                            </div>
                            <h3 class="fw-bold text-success mb-0">
                                @Model.TotalCollectionAmount.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 bg-light h-100">
                        <div class="card-body">
                            <div class="text-muted">
                                Total VAT
                            </div>
                            <h3 class="fw-bold mb-0">
                                @Model.TotalVat.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>

            </div>

            <!-- REPORT TABLE -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="bi bi-table me-1"></i>
                    Collection Transactions
                </h5>

                <span class="badge bg-light text-dark">
                    Records: @Model.Transactions.Count
                </span>
            </div>

            @if (Model.Transactions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Collection Date</th>
                                <th>Branch Code</th>
                                <th>Branch Name</th>
                                <th>SMS Account No</th>
                                <th>Ref No</th>
                                <th>Transaction ID</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">VAT</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int serial = 1;
                            }

                            @foreach (var item in Model.Transactions)
                            {
                                <tr>
                                    <td>@serial</td>

                                    <td>
                                        @item.CollectionDate?.ToString("dd-MM-yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        <strong>@item.BranchCode</strong>
                                    </td>

                                    <td>@item.BranchName</td>

                                    <td>@item.SMSAccountNo</td>

                                    <td>@item.RefNo</td>

                                    <td>@item.PayerTransactionId</td>

                                    <td class="text-end">
                                        @item.Amount.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @item.Vat.ToString("N2")
                                    </td>

                                    <td>
                                        @if (item.TxnStatus == "PaymentSuccess" ||
                                                                        item.TxnStatus == "Success")
                                        {
                                            <span class="badge bg-success">
                                                @item.TxnStatus
                                            </span>
                                        }
                                        else if (item.TxnStatus == "WaitingForAcknowledgement")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.TxnStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @(item.TxnStatus ?? "Unknown")
                                            </span>
                                        }
                                    </td>
                                </tr>

                                serial++;
                            }
                        </tbody>

                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="7" class="text-end">
                                    Total
                                </td>
                                <td class="text-end">
                                    @Model.TotalCollectionAmount.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @Model.TotalVat.ToString("N2")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox"
                       style="font-size:50px;">
                    </i>

                    <h5 class="mt-3">
                        No BREB collection found
                    </h5>

                    <p class="text-muted mb-0">
                        No transactions found for the selected date and branch.
                    </p>
                </div>
            }

        </div>
    </div>
</div>
