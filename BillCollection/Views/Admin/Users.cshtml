
@model BillCollection.Models.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill"></i>
                Manage Users
            </h2>

            <p class="text-muted mb-0">
                Manage branch users and reset passwords.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>

    </div>
</div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-1"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-1"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- USERS CARD -->
    <div class="card shadow-sm border-0">

        <!-- CARD HEADER -->
    <div class="card-header bg-white border-bottom">

            <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0 text-dark">
                <i class="bi bi-person-lines-fill me-1"></i>
                User List
            </h5>

                <div class="d-flex align-items-center gap-2"> 
                    <span class="badge bg-light text-dark"> Total: @Model.TotalRecords
                    </span> 
                    <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-success btn-sm">
                        <i class="bi bi-person-plus-fill me-1"></i>

                     Add User
                 </a>
                </div>

        </div>


        <div class="card-body">

            <!-- SEARCH -->
            <form asp-controller="Admin"
                  asp-action="Users"
                  method="get"
                  class="row g-2 mb-4">

                <!-- SEARCH BOX -->
                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Search username, name or role..." />

                    </div>

                </div>


                <!-- PAGE SIZE -->
                <div class="col-md-3">

                    <select name="pageSize"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="25"
                                selected="@(Model.PageSize == 25)">
                            25 per page
                        </option>

                        <option value="50"
                                selected="@(Model.PageSize == 50)">
                            50 per page
                        </option>

                        <option value="100"
                                selected="@(Model.PageSize == 100)">
                            100 per page
                        </option>

                    </select>

                </div>


                <!-- BUTTONS -->
                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-1"></i>
                        Search

                    </button>

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-clockwise"></i>
                        Reset

                    </a>

                </div>

            </form>


            <!-- USER TABLE -->
            @if (Model.Users != null && Model.Users.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width:70px;">
                                    #
                                </th>

                                <th>
                                    Username
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th style="width:220px;">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int serial =
                                ((Model.Page - 1) * Model.PageSize) + 1;
                            }


                            @foreach (var user in Model.Users)
                            {
                                <tr>

                                    <!-- SERIAL -->
                                    <td>
                                        @serial
                                    </td>


                                    <!-- USERNAME -->
                                    <td>
                                        <strong>
                                            @user.Username
                                        </strong>
                                    </td>


                                    <!-- ROLE -->
                                    <td>

                                        @if (user.Role == "HeadOffice")
                                        {
                                            <span class="badge bg-primary">

                                                <i class="bi bi-shield-fill me-1"></i>

                                                HeadOffice

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-building me-1"></i>

                                                @user.Role

                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->
                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="ResetPassword"
                                               asp-route-id="@user.Id"
                                               class="btn btn-warning btn-sm">

                                                <i class="bi bi-key-fill me-1"></i>

                                                Reset Password

                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    disabled>

                                                <i class="bi bi-lock-fill me-1"></i>

                                                Inactive

                                            </button>
                                        }

                                    </td>

                                </tr>

                                serial++;
                            }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION FOOTER -->
            <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">

                <!-- RECORD INFORMATION -->
                <div class="text-muted">

                    Showing

                    <strong>
                        @(((Model.Page - 1) * Model.PageSize) + 1)
                    </strong>

                    -

                    <strong>
                        @(Math.Min(
                                                Model.Page * Model.PageSize,
                                                Model.TotalRecords))
                    </strong>

                        of

                        <strong>
                            @Model.TotalRecords
                        </strong>

                        users

                    </div>


                    <!-- PAGINATION -->
                @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="User pagination">

                            <ul class="pagination mb-0">

                                <!-- PREVIOUS -->
                                @if (Model.Page > 1)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Users"
                                           asp-route-search="@Model.Search"
                                           asp-route-page="@(Model.Page - 1)"
                                           asp-route-pageSize="@Model.PageSize">

                                            <i class="bi bi-chevron-left"></i>

                                            Previous

                                        </a>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">

                                            <i class="bi bi-chevron-left"></i>

                                            Previous

                                        </span>

                                    </li>
                                }


                                <!-- PAGE NUMBERS -->
                                @{
                                    int startPage = Math.Max(1, Model.Page - 2);

                                    int endPage =
                                    Math.Min(Model.TotalPages, Model.Page + 2);
                                }


                                @if (startPage > 1)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Users"
                                           asp-route-search="@Model.Search"
                                           asp-route-page="1"
                                           asp-route-pageSize="@Model.PageSize">

                                            1

                                        </a>

                                    </li>

                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">

                                            <span class="page-link">
                                                ...
                                            </span>

                                        </li>
                                    }
                                }


                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    if (i == Model.Page)
                                    {
                                        <li class="page-item active">

                                            <span class="page-link">
                                                @i
                                            </span>

                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item">

                                            <a class="page-link"
                                               asp-controller="Admin"
                                               asp-action="Users"
                                               asp-route-search="@Model.Search"
                                               asp-route-page="@i"
                                               asp-route-pageSize="@Model.PageSize">

                                                @i

                                            </a>

                                        </li>
                                    }
                                }


                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">

                                            <span class="page-link">
                                                ...
                                            </span>

                                        </li>
                                    }

                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Users"
                                           asp-route-search="@Model.Search"
                                           asp-route-page="@Model.TotalPages"
                                           asp-route-pageSize="@Model.PageSize">

                                            @Model.TotalPages

                                        </a>

                                    </li>
                                }


                                <!-- NEXT -->
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Users"
                                           asp-route-search="@Model.Search"
                                           asp-route-page="@(Model.Page + 1)"
                                           asp-route-pageSize="@Model.PageSize">

                                            Next

                                            <i class="bi bi-chevron-right"></i>

                                        </a>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">

                                            Next

                                            <i class="bi bi-chevron-right"></i>

                                        </span>

                                    </li>
                                }

                            </ul>

                        </nav>
                    }

                </div>

            }
            else
            {
                <!-- NO USERS -->
                <div class="text-center py-5">

                    <i class="bi bi-people"
                       style="font-size:50px;">
                    </i>

                    <h5 class="mt-3">
                        No users found
                    </h5>

                    <p class="text-muted mb-0">

                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <span>
                                No users matched your search.
                            </span>
                        }
                        else
                        {
                            <span>
                                There are no users available.
                            </span>
                        }

                    </p>

                </div>
            }

        </div>

    </div>

</div>

