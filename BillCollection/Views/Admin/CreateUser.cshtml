@model BillCollection.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="mb-1">
                <i class="bi bi-person-plus-fill me-2"></i>
                Create New User
            </h3>

            <small class="text-muted">
                Create a new system user
            </small>
        </div>

        <a asp-controller="Admin"
           asp-action="Users"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Users
        </a>

    </div>


    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-person-vcard me-1"></i>
                User Information
            </h5>
        </div>


        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="CreateUser"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- Account Information -->
                <h6 class="text-primary mb-3">
                    <i class="bi bi-person-lock me-1"></i>
                    Account Information
                </h6>


                <div class="row g-3">

                    <!-- Username -->
                    <div class="col-md-6">

                        <label asp-for="Username"
                               class="form-label">
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Role -->
                    <div class="col-md-6">

                        <label asp-for="Role"
                               class="form-label">
                        </label>

                        <select asp-for="Role"
                                class="form-select"
                                id="Role">

                            <option value="Branch">
                                Branch
                            </option>

                            <option value="HeadOffice">
                                Head Office
                            </option>

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Password -->
                    <div class="col-md-6">

                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <input asp-for="Password"
                               class="form-control" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Confirm Password -->
                    <div class="col-md-6">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Display Name -->
                    <div class="col-md-6">

                        <label asp-for="DisplayName"
                               class="form-label">
                        </label>

                        <input asp-for="DisplayName"
                               class="form-control" />

                        <span asp-validation-for="DisplayName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Branch -->
                    <div class="col-md-6"
                         id="branchSection">

                        <label asp-for="BranchId"
                               class="form-label">
                            Branch
                        </label>

                        <select asp-for="BranchId"
                                class="form-select"
                                id="BranchId">

                            <option value="">
                                -- Select Branch --
                            </option>

                            @foreach (var branch in Model.Branches)
                            {
                                <option value="@branch.Id">
                                    @branch.BranchCode - @branch.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="BranchId"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Employee Information -->
                <h6 class="text-primary mb-3">
                    <i class="bi bi-briefcase me-1"></i>
                    Employee Information
                </h6>


                <div class="row g-3">

                    <!-- Employee ID -->
                    <div class="col-md-4">

                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <input asp-for="EmployeeId"
                               class="form-control" />

                    </div>


                    <!-- Designation -->
                    <div class="col-md-4">

                        <label asp-for="Designation"
                               class="form-label">
                        </label>

                        <input asp-for="Designation"
                               class="form-control" />

                    </div>


                    <!-- Mobile -->
                    <div class="col-md-4">

                        <label asp-for="MobileNumber"
                               class="form-label">
                        </label>

                        <input asp-for="MobileNumber"
                               class="form-control" />

                    </div>


                    <!-- Email -->
                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control" />

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Permissions -->
                <h6 class="text-primary mb-3">
                    <i class="bi bi-shield-check me-1"></i>
                    Permissions
                </h6>


                <div class="row">

                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="CanEditCbsDetails"
                                   class="form-check-input" />

                            <label asp-for="CanEditCbsDetails"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="form-check">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active User
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-4 pt-3 border-top">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle me-1"></i>
                        Create User

                    </button>


                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function toggleBranch() {

            var role = document.getElementById("Role").value;

            var branchSection =
                document.getElementById("branchSection");

            var branchSelect =
                document.getElementById("BranchId");


            if (role === "Branch") {

                branchSection.style.display = "block";

            }
            else {

                branchSection.style.display = "none";

                branchSelect.value = "";

            }
        }


        document
            .getElementById("Role")
            .addEventListener("change", toggleBranch);


        document.addEventListener(
            "DOMContentLoaded",
            toggleBranch
        );

    </script>
}