@model BillCollection.ViewModels.BREB.BREBAdminSummaryReportViewModel

@{
    ViewData["Title"] = "BREB Summary Report";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-table"></i>
                BREB Summary Report
            </h2>
            <p class="text-muted mb-0">
                Successful payments per branch and day. Revenue = Amount - VAT; Txn Amount = Revenue + VAT.
            </p>
        </div>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="BREBSummaryReport" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Date From</label>
                    <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Date To</label>
                    <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Branch Code</label>
                    <input type="text" name="branchCode" value="@Model.BranchCode" class="form-control" placeholder="All branches" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">View</button>
                    <a class="btn btn-outline-success"
                       asp-controller="Admin" asp-action="BREBSummaryReportCsv"
                       asp-route-from="@Model.From.ToString("yyyy-MM-dd")"
                       asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
                       asp-route-branchCode="@Model.BranchCode">Excel (CSV)</a>
                    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
                </div>
            </form>
        </div>
    </div>

    <h5 class="fw-bold text-decoration-underline mb-3">
        Postpaid Collection Summary From @Model.From.ToString("yyyy-MM-dd") To @Model.To.ToString("yyyy-MM-dd")
    </h5>

    @if (Model.Branches.Any())
    {
        foreach (var branch in Model.Branches)
        {
            <table class="table table-bordered table-sm mb-4" style="max-width: 900px;">
                <thead>
                    <tr class="table-light">
                        <th colspan="6" class="fs-6">@branch.BranchName - @branch.BranchCode</th>
                    </tr>
                    <tr class="table-dark">
                        <th style="width: 6%;">SL</th>
                        <th>Collection Date</th>
                        <th class="text-end">No Of Txn</th>
                        <th class="text-end">Revenue</th>
                        <th class="text-end">Vat</th>
                        <th class="text-end">Txn Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sl = 0; }
                    @foreach (var day in branch.Days)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td>@day.Date.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@day.TxnCount.ToString("N0")</td>
                            <td class="text-end">@day.Revenue.ToString("N2")</td>
                            <td class="text-end">@day.Vat.ToString("N2")</td>
                            <td class="text-end">@day.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="fw-bold table-light">
                        <td colspan="2" class="text-end">Branch Total</td>
                        <td class="text-end">@branch.TxnCount.ToString("N0")</td>
                        <td class="text-end">@branch.Revenue.ToString("N2")</td>
                        <td class="text-end">@branch.Vat.ToString("N2")</td>
                        <td class="text-end">@branch.Amount.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        }

        <table class="table table-bordered table-sm" style="max-width: 900px;">
            <tr class="fw-bold table-warning">
                <td style="width: 38%;" class="text-end">Grand Total (@Model.Branches.Count branch(es))</td>
                <td class="text-end">@Model.GrandTxnCount.ToString("N0")</td>
                <td class="text-end">@Model.GrandRevenue.ToString("N2")</td>
                <td class="text-end">@Model.GrandVat.ToString("N2")</td>
                <td class="text-end">@Model.GrandAmount.ToString("N2")</td>
            </tr>
        </table>
    }
    else
    {
        <div class="alert alert-info">No successful BREB collections found for this period.</div>
    }
</div>
