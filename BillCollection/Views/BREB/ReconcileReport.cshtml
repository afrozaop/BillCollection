@model BillCollection.ViewModels.BREB.BREBReconcileReportViewModel

@{
    ViewData["Title"] = "BREB Reconcile Report";
}

<div class="container mt-4">
    <h2>BREB Reconcile Report</h2>
    <p class="text-muted">
        Payments of one day in this system compared with BREB's own report (<code>report/detail</code>).
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.IsMockMode)
    {
        <div class="alert alert-warning">
            <strong>TEST MODE</strong> - BREB side is simulated from the local records.
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.BrebError))
    {
        <div class="alert alert-danger">
            <strong>Could not load the BREB report:</strong> @Model.BrebError<br />
            Only the local figures are shown below.
        </div>
    }

    <form method="get" asp-action="ReconcileReport" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label" for="date">Date</label>
            <input type="date" id="date" name="date" class="form-control"
                   value="@Model.ReportDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Show</button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card"><div class="card-body">
            <div class="text-muted">Local - Successful</div>
            <div class="fs-4">@Model.SuccessfulPayments</div>
            <div>@Model.TotalSuccessfulAmount.ToString("N2")</div>
        </div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">
            <div class="text-muted">BREB - Paid Acknowledged</div>
            <div class="fs-4">@Model.BrebPaidCount</div>
            <div>@Model.BrebPaidAmount.ToString("N2")</div>
        </div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">
            <div class="text-muted">Local - Pending / Waiting</div>
            <div class="fs-4">@Model.PendingPayments</div>
            <div class="text-muted">BREB waiting: @Model.BrebWaitingCount</div>
        </div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">
            <div class="text-muted">Matched / Mismatch</div>
            <div class="fs-4">
                <span class="text-success">@Model.MatchedCount</span> /
                <span class="@(Model.MismatchCount > 0 ? "text-danger" : "")">@Model.MismatchCount</span>
            </div>
        </div></div></div>
    </div>

    @if (Model.Rows.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Result</th>
                        <th>Txn Id</th>
                        <th>SMS Account No</th>
                        <th>Reference No</th>
                        <th class="text-end">Amount</th>
                        <th>Local</th>
                        <th>BREB</th>
                        <th>Note</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.OrderByDescending(r => r.Result != "Matched"))
                    {
                        <tr class="@(row.Result == "Matched" ? "" : "table-warning")">
                            <td>
                                @if (row.Result == "Matched")
                                {
                                    <span class="badge bg-success">Matched</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@row.Result</span>
                                }
                            </td>
                            <td>@row.TransactionId</td>
                            <td>@row.SMSAccountNo</td>
                            <td class="text-break">@row.RefNo</td>
                            <td class="text-end">@row.Amount.ToString("N2")</td>
                            <td>@row.LocalStatus</td>
                            <td>@row.BrebStatus</td>
                            <td>@row.Note</td>
                            <td>
                                @if (row.TransactionId.HasValue && row.CanSync)
                                {
                                    <partial name="_RowActions" model="@(new BillCollection.ViewModels.BREB.BREBRowActionViewModel
                                    {
                                        TransactionId = row.TransactionId.Value,
                                        ReturnTo = "ReconcileReport",
                                        Date = Model.ReportDate,
                                        CanDispute = row.CanDispute
                                    })" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (string.IsNullOrEmpty(Model.BrebError))
    {
        <div class="alert alert-info">No payments found for this date.</div>
    }

    <a asp-controller="BREB" asp-action="Index" class="btn btn-secondary mt-3">Back to BREB</a>
</div>
