@model BillCollection.ViewModels.BREB.BREBBillCollectionViewModel

@{
    ViewData["Title"] = "BREB Bill Collection";
}

<div class="container mt-4">

    <h2>BREB Bill Collection</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <hr />

    <!-- Bill Query -->
    <form asp-action="BillCollection"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="SMSAccountNo"
                           class="form-label">
                        SMS Account Number
                    </label>

                    <input asp-for="SMSAccountNo"
                           class="form-control"
                           placeholder="Enter SMS Account Number"
                           autocomplete="off" />

                    <span asp-validation-for="SMSAccountNo"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Bill Query
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>


    <!-- Bill Information -->
    @if (ViewBag.BillResult != null)
    {
        var bill = ViewBag.BillResult
        as BillCollection.Models.BREB.BREBBillingInfoResponse;

        if (bill != null)
        {
            <hr class="my-4" />

            <h4 class="mb-3">
                Bill Information
            </h4>

            <div class="card">

                <div class="card-body">

                    <table class="table table-bordered mb-3">

                        <tr>
                            <th style="width: 35%;">
                                SMS Account No
                            </th>
                            <td>
                                @bill.SMSAccountNo
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Reference No
                            </th>
                            <td>
                                @bill.RefNo
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Bill Month
                            </th>
                            <td>
                                @bill.BillMonth
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Due Type
                            </th>
                            <td>
                                @bill.DueType
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Amount
                            </th>
                            <td>
                                @bill.Amount.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                VAT
                            </th>
                            <td>
                                @bill.Vat.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Expires In
                            </th>
                            <td>
                                @bill.ExpiresIn
                            </td>
                        </tr>

                    </table>


                    <!-- Customer Payable Amount -->
                    <div class="alert alert-info">

                        <strong>
                            Customer Payable Amount:
                        </strong>

                        <span class="ms-2">
                            @bill.Amount.ToString("N2")
                        </span>

                    </div>


                    <!-- Pay Bill -->
                    @if (Model.TransactionId.HasValue)
                    {
                        <form asp-controller="BREB"
                              asp-action="PayBill"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="transactionId"
                                   value="@Model.TransactionId.Value" />

                            <button type="submit"
                                    class="btn btn-success"
                                    onclick="return confirm('Are you sure you want to submit this payment?');">

                                Pay Bill

                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3">
                            Payment transaction could not be created.
                        </div>
                    }

                </div>

            </div>
        }
    }

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}