@model IEnumerable<BillCollection.Models.BranchBillProvider>

@{
    ViewData["Title"] = "Branch Dashboard";
    var branch = ViewBag.Branch as BillCollection.Models.Branch;
}

<div class="container mt-4">

    <!-- Branch Header -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-1">
                Branch Dashboard
            </h2>

            <p class="text-muted mb-0">
                @branch?.BranchCode - @branch?.Name
            </p>

        </div>

    </div>


    <!-- Provider Access -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Your Bill Provider Access
            </h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="row">

                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 mb-3">

                            <div class="card h-100 shadow-sm">

                                <div class="card-body d-flex flex-column">

                                    <h5 class="fw-bold">
                                        @item.Provider?.ProviderName
                                    </h5>

                                    <p class="text-muted mb-3">
                                        Code:
                                        @item.Provider?.ProviderCode
                                    </p>


                                    @* =========================
                                   BREB
                                   ========================= *@

                                    @if (item.Provider?.ProviderCode == "BREB")
                                    {
                                        <a asp-controller="BREB"
                                           asp-action="Index"
                                           class="btn btn-primary mt-auto">

                                            Open BREB

                                        </a>
                                    }


                                    @* =========================
                                   Other Providers
                                   ========================= *@

                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-secondary mt-auto"
                                                disabled>

                                            View Bills

                                        </button>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">

                    No bill provider has been assigned
                    to this branch.

                </div>
            }

        </div>

    </div>
  

</div>
