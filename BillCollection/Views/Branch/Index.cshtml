@model BillCollection.ViewModels.BranchDashboardViewModel

@{
    ViewData["Title"] = "Branch Dashboard";
}

<div class="container mt-4">

    <!-- Branch header -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="fw-bold mb-1">Branch Dashboard</h2>
                <p class="text-muted mb-0">@Model.Branch.BranchCode - @Model.Branch.Name</p>
            </div>
            <div class="text-end">
                <div class="text-muted small">@Model.Today.ToString("dddd, dd MMM yyyy")</div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-1">Refresh</a>
            </div>
        </div>
    </div>

    @if (!Model.Providers.Any())
    {
        <div class="alert alert-warning">No bill provider has been assigned to this branch.</div>
    }
    else
    {
        <!-- Totals over all providers -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted">Today's collection</div>
                        <div class="fs-3 fw-bold text-success">Tk @Model.TodayAmount.ToString("N2")</div>
                        <div>@Model.TodayCount bill(s)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted">This month</div>
                        <div class="fs-3 fw-bold">Tk @Model.MonthAmount.ToString("N2")</div>
                        <div>@Model.MonthCount bill(s)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100 @(Model.AttentionCount > 0 ? "border-danger" : "")">
                    <div class="card-body">
                        <div class="text-muted">Needs attention</div>
                        <div class="fs-3 fw-bold @(Model.AttentionCount > 0 ? "text-danger" : "text-success")">@Model.AttentionCount</div>
                        <div>@(Model.AttentionCount > 0 ? "payment(s) waiting, pending or in dispute" : "everything is settled")</div>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-3">Provider-wise summary</h5>

        <div class="row g-3">
            @foreach (var p in Model.Providers)
            {
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">

                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@p.ProviderName <span class="badge bg-secondary ms-1">@p.ProviderCode</span></span>

                            @if (p.ProviderCode == "BREB")
                            {
                                <a asp-controller="BREB" asp-action="Index" class="btn btn-sm btn-primary">Open BREB</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-secondary" disabled>View Bills</button>
                            }
                        </div>

                        <div class="card-body">
                            @if (!p.HasSummary)
                            {
                                <p class="text-muted mb-0">Collection summary is not available for this provider yet.</p>
                            }
                            else
                            {
                                <div class="row text-center g-2 mb-3">
                                    <div class="col-4">
                                        <div class="border rounded p-2 h-100">
                                            <div class="text-muted small">Today</div>
                                            <div class="fw-bold">Tk @p.TodayAmount.ToString("N2")</div>
                                            <div class="small">@p.TodayCount bill(s)</div>
                                            <div class="small text-muted">VAT @p.TodayVat.ToString("N2")</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border rounded p-2 h-100">
                                            <div class="text-muted small">This month</div>
                                            <div class="fw-bold">Tk @p.MonthAmount.ToString("N2")</div>
                                            <div class="small">@p.MonthCount bill(s)</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border rounded p-2 h-100 @(p.AttentionCount > 0 ? "border-danger" : "")">
                                            <div class="text-muted small">Needs attention</div>
                                            <div class="fw-bold @(p.AttentionCount > 0 ? "text-danger" : "text-success")">@p.AttentionCount</div>
                                            <div class="small">
                                                <a asp-controller="BREB" asp-action="UnsuccessfulList">@p.PendingCount waiting/pending</a>
                                            </div>
                                            <div class="small">
                                                <a asp-controller="BREB" asp-action="DisputeList">@p.DisputeCount dispute(s)</a>
                                            </div>
                                            @if (p.FailedTodayCount > 0)
                                            {
                                                <div class="small text-muted">@p.FailedTodayCount failed today</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
